            <Pin Id="HcmJItcZbUkPeg6DfgSFWI" Name="Bounds" Kind="InputPin" DefaultValue="870, 284, 613, 436" />
            <Pin Id="AST988MrfODNsSgYC0FlBi" Name="Save Bounds" Kind="InputPin" IsHidden="true" />
            <Pin Id="CINMmGAD5DILyCAYTmgFIj" Name="Bound to Document" Kind="InputPin" IsHidden="true" />
