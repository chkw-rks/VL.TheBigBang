          <Pad Id="RQYlGfcF78cQOrZDx7hUsS" Bounds="3395,1507,400,204" ShowValueBox="true" isIOBox="true" Value="Most node based environments offer methods to create subpatches which abstract certain functionality and avoid duplicated code all over the place. This is also possible in vvvv using so-called Process Nodes. In fact, every node that is in the Node Browser and that we have used so far, is a Process Node in the background and it is open to the user to create as many of these as desired.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="SqOas3kIVYFNXgMpBIxTFb" Bounds="174,140,589,46" ShowValueBox="true" isIOBox="true" Value="38. Object-Oriented Patching">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">22</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="R77tPRvasN2PJ7SEzSJAb4" Bounds="174,227,538,256" ShowValueBox="true" isIOBox="true" Value="- tiny example - something like a Person, nothing rendered, maybe the Reader? with Create and Split, equivalent to Join and Spiut Vector2, very good reference here ALREADY!!&#xD;&#xA;&#xD;&#xA;IMPORTANT RESOURCES&#xD;&#xA;https://claude.ai/share/c4b342f3-1549-48ad-8b1d-9e6f08ef25b5&#xD;&#xA;https://forum.vvvv.org/t/when-to-pick-a-process-a-record-or-a-class/21624&#xD;&#xA;https://thegraybook.vvvv.org/reference/language/nodes.html&#xD;&#xA;https://thegraybook.vvvv.org/reference/language/operations.html">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
