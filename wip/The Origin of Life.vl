          <Overlay Id="SdR6irzjQDQP6QQKM7IauJ" Name="01. Immutability vs. Mutability" Bounds="2955,17836,822,561" />
          <Pad Id="Fc4ejKx2hs0Lyx0nEAtNJd" Bounds="3057,18035,476,214" ShowValueBox="true" isIOBox="true" Value="&quot;Mutability refers to data types that can be accessed and changed after they've been created and stored in memory. &#xD;&#xA;&#xD;&#xA;Immutability, on the other hand, refers to data types that you can't change after creating them – but that you can still access in the memory.&quot;">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">14</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Enz3u05MrtKPReEBVJvNGd" Bounds="3060,18263,563,19" ShowValueBox="true" isIOBox="true" Value="https://www.freecodecamp.org/news/mutability-vs-immutability-in-javascript">
