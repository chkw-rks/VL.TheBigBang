          </Pad>
          <Pad Id="Nx0OweOCcDML1EzaPMZCp4" Bounds="3681,8073,364,70" ShowValueBox="true" isIOBox="true" Value="https://thegraybook.vvvv.org/reference/language/properties.html">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
