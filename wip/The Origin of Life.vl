          <Pad Id="NKaxQeYMFmaMZ5cCrmTOjf" Bounds="99,2888,844,46" ShowValueBox="true" isIOBox="true" Value="40. Use Case I: Bundling Properties">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
