          <Pad Id="NKaxQeYMFmaMZ5cCrmTOjf" Bounds="128,10781,844,46" ShowValueBox="true" isIOBox="true" Value="40. Use Case I: Bundling Properties">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">22</p:fontsize>
