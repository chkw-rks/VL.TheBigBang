          <Pad Id="NfF7Q4eUkUnOBp33Cz9zKw" Bounds="3681,8054,246,19" ShowValueBox="true" isIOBox="true" Value="The Gray Book on Properties&#xD;&#xA;">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
