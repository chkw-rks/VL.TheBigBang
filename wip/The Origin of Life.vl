              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Bang</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="HudzRQJTTBBMW0QkVVPBIs" Comment="Shrink" Bounds="1775,9644,35,35" ShowValueBox="true" isIOBox="true" Value="False">
