          <Overlay Id="VYGKdt8lhOoOV1ynCxd3eq" Name="01. Immutability vs. Mutability" Bounds="4439,682,822,561" />
          <Pad Id="SqaC0CPp256P44mXuZbc4C" Bounds="4541,881,476,214" ShowValueBox="true" isIOBox="true" Value="&quot;Mutability refers to data types that can be accessed and changed after they've been created and stored in memory. &#xD;&#xA;&#xD;&#xA;Immutability, on the other hand, refers to data types that you can't change after creating them – but that you can still access in the memory.&quot;">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">14</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="TktPRzJahv7OBTA7GTc5EM" Bounds="4544,1109,563,19" ShowValueBox="true" isIOBox="true" Value="https://www.freecodecamp.org/news/mutability-vs-immutability-in-javascript">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Link</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="JvbmzZbe0t1QOQGPGMJQde" Bounds="4462,3232,554,29" ShowValueBox="true" isIOBox="true" Value="You pick a mutable Class, when you:">
