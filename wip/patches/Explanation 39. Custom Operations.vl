          <Pad Id="38W0yeej8VlNfiXhoa1EvB" Comment="Color" Bounds="2344,2731,136,15" ShowValueBox="true" isIOBox="true" Value="1, 0, 0, 1">
            <p:TypeAnnotation LastCategoryFullName="Color" LastDependency="VL.CoreLib.vl">
