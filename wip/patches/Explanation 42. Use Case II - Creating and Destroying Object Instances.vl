            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="2rbUoauJbfj1QsNgNynGre" Bounds="1092,1500,150,25" ShowValueBox="true" isIOBox="true" Value="Other Resources">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
