              <CategoryReference Kind="Category" Name="Primitive" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Bang</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="1Heyjep2eFGJLMYy6LF3Ae" Comment="Shrink" Bounds="2451,2953,35,35" ShowValueBox="true" isIOBox="true" Value="False">
