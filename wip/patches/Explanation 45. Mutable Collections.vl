          <Pad Id="4ig3wn0u45nPxkshxPI4st" Comment="Item" Bounds="1722,2699,136,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="1Wyrvla7Qeyv0r5U1w9vI4" Comment="Period" Bounds="1908,2531,35,15" ShowValueBox="true" isIOBox="true" Value="5">
