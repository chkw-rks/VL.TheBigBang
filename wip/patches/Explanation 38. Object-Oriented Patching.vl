          <Pad Id="5zxXb0aaRDi7q9gRxr0cGY" Comment="Position" Bounds="1104,935,45,28" ShowValueBox="true" isIOBox="true" Value="0, 0">
            <p:TypeAnnotation LastCategoryFullName="2D" LastDependency="VL.CoreLib.vl">
