          <Pad Id="4zQKDjmMY0QOcWWxIYVyw1" Bounds="3603,3180,679,29" ShowValueBox="true" isIOBox="true" Value="Dashed links mean that the type sent from above is mutable">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
