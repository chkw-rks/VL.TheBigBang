          </Pad>
          <Overlay Id="4HGiNpSsnc7SI1jZKncnqQ" Name="01. Immutability vs. Mutability" Bounds="3556,3046,822,561" />
          <Pad Id="6qBmT6doGHJRetbDzWkFqS" Bounds="3658,3245,476,214" ShowValueBox="true" isIOBox="true" Value="&quot;Mutability refers to data types that can be accessed and changed after they've been created and stored in memory. &#xD;&#xA;&#xD;&#xA;Immutability, on the other hand, refers to data types that you can't change after creating them – but that you can still access in the memory.&quot;">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">14</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="4Bkog3QvRSyz48zkbc2Yy9" Bounds="3661,3473,563,19" ShowValueBox="true" isIOBox="true" Value="https://www.freecodecamp.org/news/mutability-vs-immutability-in-javascript">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Link</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="6XCiLMHmjfnxRXtKbgnbQo" Bounds="4430,3227,728,29" ShowValueBox="true" isIOBox="true" Value="Immutable types have to be stored in a pad when changed through operations">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">14</p:fontsize>
